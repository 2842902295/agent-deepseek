# ===== 桌面单机版 .env 覆盖项 =====
# pack_desktop.py 生成安装目录 .env 时，以根 .env 为底，用下列键覆盖（或追加）同名项。
# 数据库、模型等远程凭据沿用根 .env，不在这里重复。
DEBUG=false
SERVE_FRONTEND=true
DESKTOP_HOST=127.0.0.1
DESKTOP_PORT=__APP_PORT__
REDIS_URL="redis://localhost:6379/0"
PUBLIC_BASE_URL=http://localhost:__APP_PORT__
# 纯客户端模式：共享远程库的表结构/菜单/API清单/种子数据/定时任务全部由服务端部署保证，
# 启动时跳过建表 DDL、modify_db、refresh_api_list、init_users、技能 seed、向量构建、调度器，
# 省掉每次启动几百次串行远程往返（启动慢的最大头）。服务器部署 / Docker 无此变量，不受影响。
DESKTOP_CLIENT_MODE=true
# 构建戳：pack_desktop.py 打包时的单一事实源（与 build-info.json、安装包文件名后缀同源）。
# app-config 接口经 build_version 字段透出，供 Electron 壳「发现新版本」对比（阶段 2）。
DESKTOP_BUILD_VERSION=__BUILD_VERSION__
# 更新包下载地址：空 = 只提示有新版本、不给下载入口；阶段 2 接入更新渠道后填写
DESKTOP_UPDATE_URL=

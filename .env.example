# ==============================================================================
# Agent DeepSeek · 环境变量模板
# 复制为 .env 后填写自己的凭据：cp .env.example .env
# 生产部署使用 .env.prod（docker compose env_file 读取），字段与本文件一致。
# ⚠️ .env / .env.prod 含敏感凭据，已在 .gitignore 中，切勿提交到代码仓库！
# ==============================================================================

# ---- 应用基础 ----
VERSION="0.1.0"
APP_TITLE="Agent DeepSeek"
APP_DESCRIPTION="基于 Deep Agents 的完整 Agent 平台"
DEBUG=true
# JWT 签名密钥，随机长串，例如：openssl rand -hex 32
SECRET_KEY=
# 对外服务的 API Key，填写后才生效（可留空）
SERVICE_API_KEY=

# ---- CORS ----
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ---- 请求日志过滤 ----
ADD_LOG_ORIGINS_INCLUDE=["*"]
ADD_LOG_ORIGINS_DECLUDE='["/system-manage","/redoc","/doc","/openapi.json"]'

# ---- Redis ----
# 本地开发：redis://localhost:6379/0 ；Docker Compose 内部：redis://redis:6379/0
REDIS_URL="redis://localhost:6379/0"

# ---- 业务数据库（OceanBase / MySQL，系统表与业务表统一单库）----
STANDARD_MYSQL_HOST=127.0.0.1
STANDARD_MYSQL_PORT=3306
STANDARD_MYSQL_USER=root
STANDARD_MYSQL_PASSWORD=
STANDARD_MYSQL_DB=fast_main

# ==============================================================================
# 模型块（CHAT / IMAGE / VIDEO 预设块）
# 运行时真相源 = DB 表 agent_model_block：新装库首启会把代码基线 _SEED_PRESETS
# 自动播种进该表，本节配置只在「播种那一刻」起作用——
#   · {BLOCK}_API_KEY      播种凭据（必填，否则该块不可用）
#   · {BLOCK}_BASE_URL / {BLOCK}_MODEL / {BLOCK}_PROVIDER
#                          可选，覆盖基线默认值（如把 CHAT_DASHSCOPE 指向自建
#                          Ollama / vLLM / 任意 OpenAI 兼容网关）
# 播种完成后（表里已有数据），换模型 / 换 key / 增删块一律由超管「模型」面板
# 完成（写 DB 热重载），修改本文件不再生效。
# ==============================================================================

# --- CHAT 通用配置（对所有 CHAT_* 块生效，块级显式配置优先）---
CHAT_CONTEXT_WINDOW=70000
CHAT_THINKING=false
CHAT_TEMPERATURE=0.6

# --- CHAT 默认块 CHAT_DASHSCOPE（必填，主对话模型）---
# 任意 OpenAI 兼容网关均可：百炼 DashScope / OpenRouter / Ollama / vLLM / 自建
CHAT_DASHSCOPE_API_KEY=sk-xxxx
# 指向自己的网关 / 模型时解开注释：
#CHAT_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#CHAT_DASHSCOPE_MODEL=qwen-plus

# --- 其他 CHAT 预设块（可选，供超管页面切换选用；不配凭据的块不会启用）---
#CHAT_GROK_API_KEY=sk-xxxx
#CHAT_DEEPSEEK_API_KEY=sk-xxxx
#CHAT_KIMI_API_KEY=sk-xxxx
#CHAT_N1N_API_KEY=sk-xxxx
#CHAT_N1N_THINKING=true

# --- VISION（视觉理解；主对话模型不支持图片时走它。不配则图片附件被忽略）---
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-xxxx
VISION_MODEL=qwen-vl-plus

# --- EMBED（向量化，知识库 / 语义检索必需）---
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_API_KEY=sk-xxxx
EMBED_MODEL=text-embedding-v4
EMBED_DIMENSION=2048
EMBED_BATCH_SIZE=10
# 向量库 provider：web-embed（云端，走 EMBED_*）或 local-embed（本地，走 LOCAL_EMBED_*）
EMBED_PROVIDER=web-embed
# 本地 embedding（EMBED_PROVIDER=local-embed 时生效，如 xinference / vLLM / Ollama）
#LOCAL_EMBED_BASE_URL=http://127.0.0.1:9997/v1
#LOCAL_EMBED_API_KEY=local
#LOCAL_EMBED_MODEL=qwen3-embedding
#LOCAL_EMBED_DIMENSION=4096
#LOCAL_EMBED_BATCH_SIZE=16

# --- DashScope 平台 Key（可选：WebSearch MCP 联网搜索等平台级服务，不与模型凭据混用）---
DASHSCOPE_API_KEY=

# ==============================================================================
# 生成能力块：IMAGE（生图）/ VIDEO（生视频）
# 与 CHAT 同理——首启播种进 agent_model_block，凭据取下方 {BLOCK}_API_KEY；
# 不配对应凭据则该块不可用、相应生成工具自动不启用。
# provider 白名单：image = apipod / gpt / qwen；video = ark / openrouter / apipod / happyhorse
# ==============================================================================

# --- IMAGE 默认块（apipod · GPT-image-2）---
IMAGE_API_KEY=sk-xxxx
# --- 其他 IMAGE 预设块（可选）---
#IMAGE_QWEN_API_KEY=sk-xxxx

# --- VIDEO 默认块 VIDEO_APIPOD（apipod · Grok Imagine 1.5 图生视频）---
VIDEO_APIPOD_API_KEY=sk-xxxx
# --- 其他 VIDEO 预设块（可选）---
#VIDEO_API_KEY=ark-xxxx                # 火山 Seedance 2.0
#VIDEO_OPENROUTER_API_KEY=sk-xxxx      # OpenRouter · Seedance 2.0
#VIDEO_HAPPYHORSE_API_KEY=sk-xxxx      # 阿里云 HappyHorse

# ==============================================================================
# 通用参数
# ==============================================================================
LLM_MAX_CONCURRENT=80
EMBEDDING_MAX_CONCURRENT=80
REQUEST_TIMEOUT=60
# 长链路 agent 需要的 LLM 请求超时（秒）
LLM_REQUEST_TIMEOUT=6000

# 内容审核方式（keyword：关键词过滤）
CONTENT_MODERATION=keyword

# 品牌变体：standard（默认）/ generic，与 web/.env 的 VITE_BRAND 对应
BRAND_VARIANT=generic

# 新用户默认积分额度
DEFAULT_CREDIT_QUOTA=10000

# 公网访问基础 URL（生成临时图片公网链接用，不含尾部斜杠）
PUBLIC_BASE_URL=https://your-domain.com

# 服务启动时是否自动续跑未完成的查重批次
AUTO_RESUME_DEDUP_BATCH=true

# ==============================================================================
# 可选 / 业务定制（开源通用部署可全部忽略）
# ==============================================================================

# --- Manticore 全文搜索引擎 ---
#MANTICORE_HOST=127.0.0.1
#MANTICORE_PORT=9306

# --- seekdb（个人知识库向量库，连接复用 STANDARD_MYSQL_* 同实例）---
SEEKDB_KB_COLLECTION=kb_entries

# --- 标准向量库每日 03:30 增量构建 ---
STANDARD_VEC_DAILY_ENABLED=false

# --- 阿里云短信（手机号登录等场景可选）---
#ALIYUN_ACCESS_KEY_ID=
#ALIYUN_ACCESS_KEY_SECRET=
#ALIYUN_SMS_SIGN_NAME=
#ALIYUN_SMS_TEMPLATE_CODE=

# --- 标准文档业务接口（标准 PDF / 图片服务，垂直业务专用）---
#JGH_PDF_API_BASE=http://127.0.0.1:48888/admin-api
#JGH_PDF_APP_ID=
#JGH_IMAGE_BASE_URL=

# --- LangSmith 追踪（可选）---
#LANGCHAIN_TRACING_V2=false
#LANGCHAIN_API_KEY=
#LANGCHAIN_PROJECT=cesi-fast-admin

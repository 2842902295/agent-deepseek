# ================================
# LangChain 配置示例
# ================================
# 复制此文件为 .env 并根据实际情况修改配置

# --------------------------------
# LLM 提供商配置
# --------------------------------

# 默认 LLM 提供商 (ollama 或 qwen)
DEFAULT_LLM_PROVIDER=ollama

# --------------------------------
# Ollama 配置 (本地模型)
# --------------------------------

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# Ollama 默认模型名称
# 可选: llama3.2, llama3.1, mistral, qwen2, 等
OLLAMA_MODEL=llama3.2

# Ollama 上下文长度限制
# 设置后会限制模型的上下文窗口大小，防止上下文过长导致显存不足（OOM）
# 不设置则使用模型默认值（通常很大，容易爆显存）
# OLLAMA_NUM_CTX=4096

# --------------------------------
# 通义千问配置
# --------------------------------

# 通义千问 API Key (从阿里云获取)
# 获取地址: https://dashscope.aliyun.com/
QWEN_API_KEY=your-qwen-api-key-here

# 通义千问模型名称
# 可选: qwen-turbo, qwen-plus, qwen-max, qwen-max-longcontext
QWEN_MODEL=qwen-turbo

# --------------------------------
# LangChain 通用配置
# --------------------------------

# 默认温度参数 (0.0-1.0)
# 较低的值使输出更确定,较高的值使输出更随机
DEFAULT_TEMPERATURE=0.7

# 请求超时时间(秒)
REQUEST_TIMEOUT=60

# --------------------------------
# LangSmith 追踪配置 (可选)
# --------------------------------

# 是否启用 LangSmith 追踪
LANGCHAIN_TRACING_V2=false

# LangSmith API Key
# 获取地址: https://smith.langchain.com/
LANGCHAIN_API_KEY=your-langsmith-api-key-here

# LangSmith 项目名称
LANGCHAIN_PROJECT=cesi-fast-admin
